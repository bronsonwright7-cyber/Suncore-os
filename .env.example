# Copy this file to .env.local for local development.
# Never commit .env.local or any file containing real credentials.

# --- Supabase project settings (Project Settings > API in the Supabase dashboard) ---

# Public: safe to expose to the browser. Used by the Supabase browser client.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# SERVER-ONLY. Full read/write access, bypasses Row Level Security.
# Do NOT prefix with NEXT_PUBLIC_. Do NOT import this into any client component.
# Only used from trusted server-side code (e.g. one-off admin scripts), never
# from normal request handling, which must run under the signed-in user's session.
SUPABASE_SERVICE_ROLE_KEY=

# --- App settings ---

# Base URL of the deployed app, used for auth redirects. e.g. http://localhost:3000
# in development, or the production Vercel URL/custom domain in production.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Ask Suncore AI (Phase B) ---

# SERVER-ONLY. Used by src/app/api/ask-suncore/route.ts to call the Anthropic
# API. Do NOT prefix with NEXT_PUBLIC_. Never imported into a Client Component.
ANTHROPIC_API_KEY=
